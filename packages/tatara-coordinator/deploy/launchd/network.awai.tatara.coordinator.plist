<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tatara coordinator as a user LaunchAgent (AWAI-3521). Replace @HOME@.
     Contains no secrets: see run-coordinator.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>network.awai.tatara.coordinator</string>
  <key>ProgramArguments</key>
  <array><string>@HOME@/.tatara/coordinator/run-coordinator.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HOME@/.tatara/coordinator/logs/coordinator.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.tatara/coordinator/logs/coordinator.log</string>
</dict>
</plist>

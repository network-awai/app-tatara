{:paths ["src" "test"]
 :tasks {test {:doc "Run tatara-core tests (local, one-off; not a CI gate)"
               :requires ([clojure.test :as t] [tatara.core-test] [tatara.verify-test])
               :task (let [r (t/run-tests 'tatara.core-test 'tatara.verify-test)]
                       (System/exit (if (t/successful? r) 0 1)))}}}
